// Schema pensado para nascer completo na Fase 1 e só "encher" nas fases seguintes.
// O campo `estrutura` do Modulo é JSONB desde o início — é a árvore de dados
// citada no guia, compartilhada entre Etapa 1 e Etapa 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusKanban {
  ORCAMENTO
  APROVADO
  PRODUCAO
  ENTREGUE
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  createdAt DateTime @default(now())

  projetos Projeto[]
}

model Cliente {
  id        String   @id @default(uuid())
  nome      String
  telefone  String?
  email     String?
  endereco  String?
  createdAt DateTime @default(now())

  projetos Projeto[]
}

model Projeto {
  id          String       @id @default(uuid())
  nome        String
  status      StatusKanban @default(ORCAMENTO)
  clienteId   String
  cliente     Cliente      @relation(fields: [clienteId], references: [id])
  usuarioId   String
  usuario     Usuario      @relation(fields: [usuarioId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  modulos    Modulo[]
  orcamentos Orcamento[]
  contratos  Contrato[]
}

model Modulo {
  id        String @id @default(uuid())
  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id])

  // --- Fase 2: só dimensoes + estrutura vazia + cor fixa ---
  // --- Fase 4: estrutura ganha divisoes/internos/portas; aparencia ganha materiais reais ---
  dimensoes Json // { largura, altura, profundidade }
  estrutura Json // { divisoes: [], internos: [], portas: [] }  (JSONB)
  aparencia Json // { cor_padrao } → depois { material_por_peca: {...} }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pecas Peca[]
}

// Introduzido na Fase 5 (gerarPecas), mas a tabela já pode existir cedo.
model Peca {
  id           String  @id @default(uuid())
  moduloId     String
  modulo       Modulo  @relation(fields: [moduloId], references: [id])
  tipo         String  // ex: "lateral", "prateleira", "porta"
  largura      Float
  altura       Float
  material     String
  posicaoCorte Json?   // resultado do bin packing: {chapaId, x, y, rotacao}
}

model Orcamento {
  id          String   @id @default(uuid())
  projetoId   String
  projeto     Projeto  @relation(fields: [projetoId], references: [id])
  valorTotal  Float
  detalhes    Json     // Fase 3: {area_m2, preco_m2}; Fase 5: {chapas, ferragens, fita_borda}
  createdAt   DateTime @default(now())
}

model Contrato {
  id            String    @id @default(uuid())
  projetoId     String
  projeto       Projeto   @relation(fields: [projetoId], references: [id])
  pdfUrl        String
  hashSha256    String?   // Fase 5
  assinadoEm    DateTime?
  assinaturaSvg String?   // Fase 5: dataURL do signature_pad
  createdAt     DateTime  @default(now())
}

// Fase 6
model RenderJob {
  id        String   @id @default(uuid())
  moduloId  String
  status    String   @default("pendente") // pendente | processando | concluido | erro
  imagemUrl String?
  createdAt DateTime @default(now())
}
